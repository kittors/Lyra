{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "react",
    "react-hooks",
    "react-perf",
    "import",
    "jsx-a11y"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "typescript/no-explicit-any": "off",
    "typescript/consistent-type-imports": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-new-array": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "react/react-in-jsx-scope": "off",
    "no-await-in-loop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "jsx-a11y/no-autofocus": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "no-shadow": "off",
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",
    "react/style-prop-object": "off",
    "react/no-unstable-nested-components": [
      "warn",
      {
        "allowAsProps": true
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/refs": "off",
    "react/memo-dependencies": "off",
    "react/immutability": "off",
    "react/purity": "off",
    "react/preserve-manual-memoization": "off",
    "react/hooks": "off",
    "react/no-deriving-state-in-effects": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/test/**"
      ],
      "rules": {
        "no-console": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": [
        "scripts/**",
        "**/scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "packages/desktop/electron/**",
        "packages/core/src/**",
        "packages/agent-cli/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "packages/core/src/**",
        "packages/desktop/electron/**",
        "packages/agent-cli/**"
      ],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": [
        "packages/desktop/src/**"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "lyra",
            "message": "经 @/services 的 bridge 访问主进程。window.lyra 只在 services/bridge.ts 与 services/host.ts 里出现——87 个文件各自直接调用它时，「这个窗口到底调了什么」和「其中哪些在手机上能用」都无法回答。"
          }
        ]
      }
    },
    {
      "files": [
        "packages/desktop/src/services/bridge.ts",
        "packages/desktop/src/services/host.ts",
        "packages/desktop/src/mobile/**"
      ],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "packages/desktop/src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "lib/ 是没有 React 的那一层——纯逻辑，不需要 DOM 就能测。要用 React 说明它是个组件，该在 ui/ 或 features/ 里。"
              },
              {
                "name": "react-dom",
                "message": "同上：lib/ 不碰渲染。"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/.expo/**",
    "packages/desktop/resources/**"
  ]
}
