{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/tokens.ts",
        "src/activity.ts",
        "src/trajectory-view.ts",
        "src/**/index.ts",
        "test/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/desktop": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "src/main.tsx",
        "test/*.test.ts",
        "scripts/*.mjs",
        "electron.vite.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts"
      ]
    },
    "packages/mobile": {
      "entry": [
        "app/**/*.tsx",
        "app.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}"
      ]
    }
  },
  "ignoreDependencies": [
    "lefthook",
    "@fontsource-variable/inter",
    "@fontsource-variable/jetbrains-mono",
    "tailwindcss",
    "@electron/rebuild",
    "expo-updates",
    "expo-system-ui",
    "react-native-css-interop",
    "@modelcontextprotocol/sdk"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "packages/mobile/metro.config.js"
  ],
  "ignoreBinaries": [
    "rg"
  ]
}
