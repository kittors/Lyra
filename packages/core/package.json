	},
	"dependencies": {
		"@lyra/registry-shared": "workspace:*",
		"@modelcontextprotocol/sdk": "1.30.0",
		"yaml": "2.8.2",
		"koffi": "^3.1.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "7.0.2"
