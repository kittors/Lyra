{
	"name": "@lyra/core",
	"version": "0.8.36",
	"private": true,
	"type": "module",
	"description": "Lyra agent kernel: providers, agent loop, tools, skills, MCP, sessions",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./thinking-options": "./src/ai/thinking-options.ts",
		"./tokens": "./src/tokens.ts",
		"./activity": "./src/activity.ts",
		"./trajectory-view": "./src/trajectory-view.ts",
		"./commands-view": "./src/commands-view.ts",
		"./schedule": "./src/config/schedule.ts",
		"./model-roles": "./src/config/model-roles.ts",
		"./commands-builtin": "./src/commands/builtin.ts",
		"./install-record": "./src/plugins/install-record.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --test --import ./test/setup.ts --experimental-strip-types test/*.test.ts"
	},
	"dependencies": {
		"@lyra/registry-shared": "workspace:*",
		"@modelcontextprotocol/sdk": "1.30.0",
		"yaml": "2.8.3",
		"koffi": "^3.1.6"
