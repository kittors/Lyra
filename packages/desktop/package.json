{
	"name": "@lyra/desktop",
	"version": "0.7.7",
	"homepage": "https://github.com/kittors/Lyra",
	"author": {
		"name": "kittors",
		"email": "kittors@users.noreply.github.com"
	},
	"private": true,
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "node scripts/brand-dev-electron.mjs && electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --test --experimental-strip-types test/*.test.ts",
		"postinstall": "node scripts/rebuild-pty.mjs && node scripts/brand-dev-electron.mjs",
		"rebuild:pty": "node scripts/rebuild-pty.mjs",
		"package": "node scripts/brand-dev-electron.mjs --restore && electron-vite build && electron-builder",
		"test:e2e": "node --test --test-concurrency=1 --experimental-strip-types e2e/*.test.ts",
		"brand:dev": "node scripts/brand-dev-electron.mjs",
		"brand:restore": "node scripts/brand-dev-electron.mjs --restore",
		"tray:icons": "node scripts/make-tray-icons.mjs"
	},
	"dependencies": {
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-css": "^6.3.1",
