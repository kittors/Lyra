{
  "name": "lyra",
  "version": "0.8.36",
  "private": true,
  "type": "module",
  "description": "Lyra — a fully self-hosted code agent with custom models, tools, skills and MCP. Desktop (Electron) + Mobile (React Native), fully synced.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @lyra/desktop dev",
    "dev:mobile": "pnpm --filter @lyra/mobile start",
    "build": "pnpm --filter @lyra/core build && pnpm --filter @lyra/desktop build",
    "build:core": "pnpm --filter @lyra/core build",
    "package": "pnpm build && pnpm --filter @lyra/desktop package",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "test": "pnpm -r --no-bail test && node --test --experimental-strip-types test/*.test.ts",
    "test:unit": "pnpm -r --no-bail test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "test:e2e": "pnpm --filter @lyra/desktop test:e2e",
    "release": "node scripts/release.mjs",
    "release:rehearse": "node scripts/release.mjs rehearse",
    "arch": "depcruise --config .dependency-cruiser.cjs packages/contract/src packages/core/src packages/desktop/src packages/desktop/shared packages/desktop/electron packages/mobile/src packages/mobile/app packages/agent-cli/src packages/registry-shared/src",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "24.13.3",
    "dependency-cruiser": "^18.2.0",
    "git-cliff": "^2.13.1",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "oxlint": "^1.78.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kittors/Lyra.git"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "koffi"
    ]
  }
}
